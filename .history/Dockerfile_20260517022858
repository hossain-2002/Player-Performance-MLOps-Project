
# Use the official slim Python image as the base
FROM python:3.11-slim

# Keep Python output unbuffered
ENV PYTHONUNBUFFERED=1

# Create and set working directory
WORKDIR /app

# Install system dependencies required to build some Python packages (e.g., xgboost)
# and a small HTTP client for healthchecks. Clean up apt lists to keep image small.
RUN apt-get update \
		&& apt-get install -y --no-install-recommends \
			 build-essential \
			 gcc \
			 g++ \
			 libgomp1 \
			 curl \
			 ca-certificates \
		&& rm -rf /var/lib/apt/lists/*

# Copy only requirements first to leverage Docker layer caching when dependencies don't change
COPY requirements.txt /app/requirements.txt

# Install Python dependencies. Using --no-cache-dir keeps the image smaller.
RUN pip install --no-cache-dir -r /app/requirements.txt

# Create a non-root user for running the app in production
RUN useradd --create-home --shell /bin/bash appuser

# Copy application code after dependencies are installed
# Copy only the directories we need for the service to reduce image size
COPY src/ /app/src/
COPY api/ /app/api/
COPY models/ /app/models/

# Change ownership to non-root user
RUN chown -R appuser:appuser /app

# Switch to the non-root user
USER appuser

# Expose the port uvicorn will listen on
EXPOSE 8000

# Healthcheck: call the /health endpoint every 30s; fail if it returns non-2xx
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
	CMD curl -f http://127.0.0.1:8000/health || exit 1

# Default command to run the FastAPI app using uvicorn
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

